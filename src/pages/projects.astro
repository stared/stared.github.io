---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LinkIcon from '@/components/LinkIcon.astro';
import { projectSlug } from '@/lib/projectSlug';
import { Content as ProjectsIntro } from '@/content/textComponents/projects.md';

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/projects/*.png',
  { eager: true }
);

const year = (date: string) => new Date(date).getUTCFullYear();

// "2019–2022" for a span, "2019" for a single year, "2019–" for still-running.
function years(start: string, end?: string | null): string {
  const from = year(start);
  if (!end) return `${from}–`;
  const to = year(end);
  return to === from ? `${from}` : `${from}–${to}`;
}

function iconKind(href: string): 'github' | 'hn' | 'arxiv' | null {
  if (/^https?:\/\/github\.com\//.test(href)) return 'github';
  if (/^https?:\/\/news\.ycombinator\.com\//.test(href)) return 'hn';
  if (/^https?:\/\/arxiv\.org\//.test(href)) return 'arxiv';
  return null;
}

const projects = (await getCollection('projects'))
  .map((entry) => entry.data)
  .sort((a, b) => b.dateStart.localeCompare(a.dateStart));
---

<BaseLayout title="Projects" description="Numerous projects by Piotr Migdał.">
  <ProjectsIntro />
  <ul class="projects">
    {projects.map((project) => {
      const image = screenshots[`/src/assets/projects/${projectSlug(project.title)}.png`]?.default;
      const kind = iconKind(project.href);
      return (
        <li class="project">
          <a class:list={['shot', kind === 'github' && 'shot--card']} href={project.href}>
            {image ? (
              <Image src={image} alt={project.title} widths={[360, 720]} sizes="(max-width: 640px) 100vw, 360px" />
            ) : (
              <span class="shot--missing" />
            )}
          </a>
          <h2 class="title">
            <a href={project.href}>{project.title}</a>
            {kind && <LinkIcon kind={kind} />}
          </h2>
          <p class="meta">
            <span class="years">{years(project.dateStart, project.dateEnd)}</span>
            {project.desc}
          </p>
          {project.mentions && (
            <p class="mentions">
              {project.mentions.map((mention) => {
                const mentionKind = iconKind(mention.href);
                return (
                  <a href={mention.href}>
                    {mentionKind ? <LinkIcon kind={mentionKind} /> : null}
                    {mention.text}
                  </a>
                );
              })}
            </p>
          )}
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .projects {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem 2rem;
  }

  .shot {
    display: block;
  }

  .shot :global(img),
  .shot--missing {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    border: 1px solid #e5e5e5;
    background: #fafafa;
  }

  /* GitHub's OpenGraph cards are 2:1; letterbox them so the repo name survives. */
  .shot--card :global(img) {
    object-fit: contain;
    background: #fff;
  }

  .shot:hover :global(img) {
    border-color: #2a7ae2;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0.6rem 0 0;
  }

  .title :global(.link-icon) {
    color: #828282;
    margin-left: 0.35em;
  }

  .meta {
    font-size: 0.85rem;
    color: #666;
    margin: 0.25rem 0 0;
  }

  .years {
    color: #999;
    font-variant-numeric: tabular-nums;
    margin-right: 0.5em;
  }

  .mentions {
    font-size: 0.8rem;
    margin: 0.35rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9em;
  }

  .mentions a {
    color: #ff6600;
  }

  .mentions :global(.link-icon) {
    margin-right: 0.25em;
  }
</style>
